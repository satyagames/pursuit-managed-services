{
  "name": "pursuits-cec",
  "version": "0.1.0",
  "private": true,
  "description": "Client-facing interactive presentation experience for iPad.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "doctor": "node scripts/doctor.js",
    "dev:api": "node --watch server/index.js",
    "dev:svelte": "vite --config migration/vite.config.ts",
    "dev:svelte:admin": "vite --config migration/vite.admin.config.ts",
    "dev:svelte:setup": "vite --config migration/vite.setup.config.ts",
    "start": "node server/index.js",
    "build:svelte": "vite build --config migration/vite.config.ts",
    "build:svelte:admin": "vite build --config migration/vite.admin.config.ts",
    "build:svelte:setup": "vite build --config migration/vite.setup.config.ts",
    "build:svelte:release": "node scripts/build-svelte-release.js",
    "validate:data": "node scripts/validate-data.js",
    "go-live": "node scripts/go-live.js",
    "test": "node scripts/run-tests.js",
    "perf": "node scripts/perf-journeys.js",
    "console:errors": "node scripts/console-errors.js",
    "test:schema": "node scripts/run-tests.js --suite test:schema",
    "build:lists-reference": "node scripts/build-lists-reference.js",
    "docs:lists": "node scripts/run-tests.js --suite docs:lists",
    "docs:modules": "node scripts/build-modules-map.js",
    "docs:check": "node scripts/check-docs.js",
    "docs:project-map": "node scripts/build-project-map.js",
    "test:namespace": "node scripts/run-tests.js --suite test:namespace",
    "test:provision": "node scripts/run-tests.js --suite test:provision",
    "test:settings": "node scripts/run-tests.js --suite test:settings",
    "test:baseline": "node scripts/run-tests.js --suite test:baseline",
    "test:9b": "node scripts/run-tests.js --suite test:9b",
    "test:release-package": "node scripts/run-tests.js --suite test:release-package",
    "package:release": "node scripts/build-release-package.js",
    "test:rehearsal": "playwright test --config migration/playwright.rehearsal.config.ts",
    "build:notices": "node scripts/build-third-party-notices.js",
    "test:oracle": "node scripts/run-tests.js --suite test:oracle",
    "oracle": "node scripts/oracle-results.js",
    "test:admin": "node scripts/run-tests.js --suite test:admin",
    "test:content": "node scripts/run-tests.js --suite test:content",
    "test:brand": "node scripts/run-tests.js --suite test:brand",
    "test:sample-pictures": "node scripts/run-tests.js --suite test:sample-pictures",
    "build:sample-pictures": "node scripts/build-sample-pictures.js",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "test:bundle": "node scripts/run-tests.js --suite test:bundle",
    "test:polling": "node scripts/run-tests.js --suite test:polling",
    "test:live": "node scripts/run-tests.js --suite test:live",
    "test:charts": "node scripts/run-tests.js --suite test:charts",
    "test:unsupported": "node scripts/run-tests.js --suite test:unsupported",
    "test:a11y": "npm run build:svelte:release && playwright test --config migration/playwright.config.ts a11y keyboard aria reflow contrast motion unsupported client-sessions role-scoping leader-dashboard users access-email",
    "test:devices": "npm run build:svelte:release && playwright test --config migration/playwright.config.ts devices",
    "test:perf": "npm run build:svelte:release && playwright test --config migration/playwright.config.ts --project=chromium performance latency",
    "test:report": "node scripts/run-tests.js --suite test:report",
    "look:exports": "node scripts/look-exports.js",
    "test:report:mutations": "node scripts/mutate-leader-report.js",
    "build:report-fonts": "python3 scripts/build-report-fonts.py",
    "test:storage": "node scripts/run-tests.js --suite test:storage",
    "test:foundation": "node scripts/run-tests.js --suite test:foundation",
    "test:effects": "npm run build:svelte:release && playwright test --config migration/playwright.config.ts effects",
    "test:styleguide": "playwright test --config migration/playwright.styleguide.config.ts",
    "test:sharepoint": "node scripts/run-tests.js --suite test:sharepoint",
    "test:build:svelte": "node scripts/run-tests.js --suite test:build:svelte",
    "test:build:svelte:admin": "node scripts/run-tests.js --suite test:build:svelte:admin",
    "test:build:svelte:setup": "node scripts/run-tests.js --suite test:build:svelte:setup",
    "test:build:svelte:release": "node scripts/run-tests.js --suite test:build:svelte:release",
    "check:svelte": "svelte-check --tsconfig migration/tsconfig.json",
    "test:migration": "npm run build:svelte:release && playwright test --config migration/playwright.config.ts",
    "test:refactor": "playwright test --config migration/playwright.refactor.config.ts",
    "export:sharepoint": "node scripts/export-sharepoint-seed.js",
    "local:site": "node scripts/local-site/server.js",
    "test:local-site": "node scripts/run-tests.js --suite test:local-site",
    "ux:shoot": "node scripts/local-site/shoot.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "chart.js": "^4.5.1",
    "cheerio": "^1.1.2",
    "esbuild": "^0.28.0",
    "pdfjs-dist": "5.4.624",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "canvas-confetti": "1.9.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "lean-qr": "^2.7.4",
    "pptxgenjs": "^4.0.1",
    "svelte": "^5.57.2",
    "svelte-spa-router": "^5.1.1"
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
