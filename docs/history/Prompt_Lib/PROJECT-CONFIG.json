{
  "schemaVersion": 1,
  "purpose": "Planning input for a coding LLM, not runtime configuration for the existing app",
  "project": {
    "name": "Pursuits CEC",
    "mode": "rebuild-in-new-workspace",
    "initialAction": "plan-and-request-approval",
    "referenceRepositoryAvailable": false,
    "preserveExistingData": true
  },
  "architecture": {
    "profile": "sharepoint-static",
    "frontend": "legacy-vanilla-with-parallel-svelte-candidate",
    "language": "javascript-and-typescript",
    "frontendBuild": "legacy-esbuild-and-svelte-vite-singlefile",
    "routing": "hash",
    "localBackend": "node-express",
    "localDatabase": "json-files",
    "productionBackend": "browser-sharepoint-rest",
    "productionDatabase": "sharepoint-lists",
    "responseStorage": "session-json-blob",
    "activeParticipantSession": "single-site-wide-admin-selected-session",
    "participantIdentification": ["sharepoint-user-staff-mode", "visitor-roster-single-use-qr-mode"],
    "additionalSharePointLists": ["AppSettings", "VisitorRoster", "UserVisitLogs"],
    "additionalSharePointSessionFields": ["ParticipationMode"],
    "additionalSharePointQrTokenFields": ["VisitorId"],
    "additionalSharePointTrackFields": ["VisitorId", "ParticipantName", "SharePointUserId"],
    "visitLogging": "idempotent-operational-entry-log-not-audit-evidence",
    "productionServer": "none",
    "contracts": "plain-objects-and-documentation",
    "liveUpdates": "polling"
  },
  "deployment": {
    "target": "sharepoint-document-library",
    "siteUrl": "REPLACE_WITH_APPROVED_HTTPS_SITE_URL",
    "documentLibrary": "Shared Documents",
    "applicationFolder": "p_cec_01",
    "logoLibrary": "ClientLogos",
    "manualFileUploadOnly": true,
    "folderUploadAvailable": false,
    "spfxAllowed": false,
    "separateProductionServerAllowed": false,
    "externalCdnAllowed": false,
    "automaticProvisioningAllowed": false,
    "deployWithoutExplicitApproval": false,
    "requirePerFileUploadChecklist": true,
    "requireDeploymentBaseline": true
  },
  "identity": {
    "participant": "existing-sharepoint-browser-session",
    "adminNavigation": "existing-pin-gate",
    "authorization": "sharepoint-permissions",
    "anonymousParticipation": false,
    "participantDataIsolationRequired": false,
    "pinIsSecurityBoundary": false
  },
  "features": {
    "adminSelectedActiveSession": true,
    "sharePointUserWelcomeInStaffMode": true,
    "visitorRosterAndNames": true,
    "visitorSpecificQrCheckIn": true,
    "disableVisitorRevokesUnusedCodes": true,
    "idempotentEntryLogging": true,
    "manualJoin": true,
    "oneTimeQrJoin": true,
    "resumeByTrackUrl": true,
    "independentParticipantTracks": true,
    "enabledSectionAgenda": true,
    "editSubmittedAnswers": true,
    "feedback": true,
    "singleSelect": true,
    "multiSelect": true,
    "trueFalse": true,
    "rankedVoting": true,
    "confidenceContinuum": true,
    "liveResults": true,
    "exportCsv": true,
    "exportPdf": true,
    "exportPowerPoint": true,
    "clientBranding": true,
    "logoUpload": true,
    "adminContentEditing": true,
    "adminSectionEnablement": true,
    "adminTrackRestart": true,
    "adminEndAndReopen": true,
    "readOnlyPreview": true,
    "sharePointSetupAndSeedImport": true,
    "soundEffects": true,
    "visualEffects": true,
    "autosave": false,
    "offlineAnswerQueue": false,
    "aiFeaturesInsideApplication": false
  },
  "behavior": {
    "saveTrigger": "explicit-submit",
    "submissionAtomicity": "per-answer",
    "progressSource": "persisted-answers",
    "resumeTransport": "track-id-in-hash-query",
    "qrTransport": "token-in-page-query",
    "rankingMethod": "borda",
    "feedbackQuestionsPerFeedbackOnlySection": 1,
    "unansweredQuestionIncludedInDenominator": false,
    "reopenRevivesOldQrCodes": false
  },
  "design": {
    "direction": "preserve-existing-design-language",
    "referenceAssetsAvailable": false,
    "participantLayout": "single-column-client-branded",
    "adminLayout": "compact-tabs-lists-and-dialogs",
    "typography": "existing-system-font-stack",
    "themeImplementation": "css-custom-properties",
    "targetDevice": "ipad-safari",
    "secondaryDevices": ["desktop-browser", "mobile-browser"],
    "accessibilityTarget": "WCAG-2.2-AA-subject-to-verification",
    "minimumTouchTargetCssPx": 44,
    "participantPrimaryActionMinHeightCssPx": 48,
    "reducedMotionRequired": true,
    "kioskMode": "review-existing-gesture-restrictions-before-enabling",
    "changeCopyWithoutApproval": false
  },
  "libraries": {
    "charts": "chart.js",
    "qr": "lean-qr",
    "pdf": "jspdf",
    "powerPoint": "pptxgenjs",
    "csv": "standards-compliant-export-with-spreadsheet-injection-protection"
  },
  "operations": {
    "expectedConcurrentParticipants": null,
    "maximumQuestionsPerSession": null,
    "retentionDays": null,
    "hostingBudget": null,
    "regionOrDataResidency": "REQUIRES_OWNER_DECISION",
    "allowPaidResources": false,
    "allowSendingProductionDataToLlm": false,
    "testDataPolicy": "synthetic-only"
  },
  "delivery": {
    "implementationStyle": "small-vertical-slices",
    "requireArchitectureDecisionLog": true,
    "requireContractTests": true,
    "requireActualDeviceQaChecklist": true,
    "requireAccessibleErrorStates": true,
    "requireRollbackInstructions": true,
    "reportUnverifiedClaims": true
  }
}